# Copy to .env. Secrets stay gitignored.
# docker compose up -d postgres minio, then bun run dev.

# Firebase web config. Vite reads these NEXT_PUBLIC_FIREBASE_* names.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin JSON, raw or base64. Also the GCS credential when S3_ENDPOINT is unset.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Photo classification, zone briefs, work orders. Heuristic fallback when empty.
GEMINI_API_KEY=

# Station feeds. OPENAQ_API_KEY is the single-key alternative to OPENAQ_API_KEYS.
OPENAQ_API_KEYS=
# OPENAQ_LOCATION_LIMIT=30
# OPENAQ_CONCURRENCY=20
# INGEST_DRAIN_BATCH=16
WAQI_API_TOKEN=
# CPCB_API_KEY=

# Schools and hospitals near a zone. Zone health skips them when empty.
# GOOGLE_PLACES_API_KEY=
# Google Air Quality advice on the zone health route.
# GOOGLE_AIR_QUALITY_API_KEY=
# Earth Engine project. Auth is FIREBASE_SERVICE_ACCOUNT_KEY.
# EARTH_ENGINE_PROJECT_ID=
# BigQuery project for the ARIMA forecast. Auth is FIREBASE_SERVICE_ACCOUNT_KEY.
# BIGQUERY_PROJECT_ID=

# WhatsApp status updates. All three required.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# WHATSAPP_CLOSURE_SECRET=

# Bearer secret for /internal routes. Any long random string.
CRON_SECRET=

# Local Postgres + MinIO. Production: set ZEPHYR_BUCKET and leave S3_* unset.
DATABASE_URL=postgres://zephyr:zephyr@127.0.0.1:5432/zephyr
S3_ENDPOINT=127.0.0.1
S3_PORT=9000
S3_ACCESS_KEY=zephyr
S3_SECRET_KEY=zephyr-local-secret
S3_BUCKET=zephyr
ZEPHYR_FIXTURES=fixtures
WORKER_URL=http://127.0.0.1:8081
ZEPHYR_DEV_AUTH=1

# Do not set PORT. It is shared and would bind api and worker to the same socket.
# API_PORT=8080
# WORKER_PORT=8081
# API_PROXY=http://127.0.0.1:8080
# Auth emulator only:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# AUTH_EMULATOR_PUBLIC_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=zephyr-local
# FIREBASE_API_KEY=demo-key
# BOOTSTRAP_OPERATOR_EMAIL=operator@zephyr.local
# BOOTSTRAP_OPERATOR_PASSWORD=change-me
