# Copy to .env and .env.local. Secrets stay gitignored.

# ── Firebase (client) ────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# ── Firebase Admin (server) ──────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_KEY=
APP_CHECK_ENFORCE=false

# ── Operators ────────────────────────────────────────────────────────────────
OPERATOR_EMAILS=

# ── Maps ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Server-side Google APIs ──────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_AIR_QUALITY_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_SPEECH_API_KEY=

# ── Earth Engine ─────────────────────────────────────────────────────────────
EARTH_ENGINE_PROJECT_ID=
EARTH_ENGINE_SERVICE_ACCOUNT_KEY=

# ── BigQuery ─────────────────────────────────────────────────────────────────
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=
BIGQUERY_LIVE_TABLE=
BIGQUERY_FORECAST_TABLE=
BIGQUERY_ARIMA_MODEL=
BIGQUERY_CLIENT_EMAIL=
BIGQUERY_PRIVATE_KEY=

# ── Ground stations ──────────────────────────────────────────────────────────
OPENAQ_API_KEY=
# Optional: extra keys (comma-separated, no quotes)
# OPENAQ_API_KEYS=key-one,key-two
# OPENAQ_LOCATION_LIMIT=40
WAQI_API_TOKEN=
CPCB_API_KEY=

# ── Other ────────────────────────────────────────────────────────────────────
IMGBB_API_KEY=
CRON_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_CLOSURE_SECRET=
TRANSLATE_API_SECRET=

# ── Zephyr local runtime ─────────────────────────────────────────────────────
# Relative paths resolve from the repo root (not the app cwd).
ZEPHYR_DATA_DIR=.data
ZEPHYR_FIXTURES=fixtures
WORKER_URL=http://127.0.0.1:8081
# Do not set PORT. It is shared and would bind api and worker to the same socket.
# Cloud Run sets PORT per service. Local overrides:
# API_PORT=8090
# WORKER_PORT=8081
# API_PROXY=http://127.0.0.1:8090
ZEPHYR_DEV_AUTH=1
ZEPHYR_STORE=file
