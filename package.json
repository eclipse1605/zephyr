{
  "name": "zephyr",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @zephyr/domain test",
    "dev:api": "pnpm --filter @zephyr/api dev",
